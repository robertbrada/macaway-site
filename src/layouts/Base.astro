---
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { link } from '../lib/links';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Inlined rather than left in base.css so the URL picks up Astro's `base`, which the
// github.io project page needs and a plain stylesheet cannot express.
const fontFace = `@font-face {
  font-family: 'Satoshi';
  font-style: normal;
  font-weight: 300 900;
  font-display: swap;
  src: url('${link('fonts/satoshi-variable.woff2')}') format('woff2');
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Stays until the owner says otherwise: there is no release to be found yet. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <!-- The header's shield, as the tab icon. The PNG is for browsers without SVG icons. -->
    <link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={link('favicon.png')} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={link('icon.png')} />
    <link
      rel="preload"
      href={link('fonts/satoshi-variable.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline set:html={fontFace}></style>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(link('icon.png'), Astro.site)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
