---
const glyphs = {
  iphone: '<rect x="7" y="2.5" width="10" height="19" rx="2.6"/><path d="M10.2 5.4h3.6"/>',
  watch:
    '<rect x="7.2" y="6.4" width="9.6" height="11.2" rx="3"/><path d="M9.3 6.2 9.7 2.6h4.6l.4 3.6M9.3 17.8l.4 3.6h4.6l.4-3.6"/>',
  airpods:
    '<path d="M8.6 3.2c1.5 0 2.4 1.1 2.4 2.7v7.7c0 1.7-1 2.9-2.4 2.9s-2.5-1.2-2.5-2.9V5.9c0-1.6 1-2.7 2.5-2.7ZM8.6 16.5v4.3"/><path d="M15.4 3.2c1.5 0 2.5 1.1 2.5 2.7v7.7c0 1.7-1.1 2.9-2.5 2.9S13 15.3 13 13.6V5.9c0-1.6 1-2.7 2.4-2.7ZM15.4 16.5v4.3"/>',
  airtag: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.2"/>',
  lock: '<rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>',
  bluetooth: '<path d="M7 7.25 17 16.75 12 21.5V2.5l5 4.75L7 16.75"/>',
  download: '<path d="M12 3v12M7 11l5 5 5-5M4 20h16"/>',
} as const;

interface Props {
  name: keyof typeof glyphs;
  size?: number;
}

const { name, size = 22 } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={glyphs[name]}
/>

<style>
  .icon {
    display: inline-block;
    vertical-align: -0.2em;
    flex: none;
  }
</style>
