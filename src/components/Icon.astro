interface Props {
  name: keyof typeof glyphs;
  size?: number;
}

const { name, size = 22 } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={glyphs[name]}
/>

<style>
  .icon {
    display: inline-block;
    vertical-align: -0.2em;
    flex: none;
  }
</style>
