---
import CopyEmail from './CopyEmail.astro';
import { link } from '../lib/links';
---

<footer>
  <div class="wrap inner">
    <span>MacAway &middot; a menu bar app for the Mac</span>
    <div class="ends">
      <CopyEmail />
      <nav aria-label="Secondary">
        <a href={link('privacy')}>Privacy</a>
        <span>&copy; {new Date().getFullYear()}</span>
      </nav>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--bg);
    color: var(--ink-muted);
    padding-block: 2rem;
    font-size: 0.9375rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }

  .ends {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }

  /* Only a phone gets to stack these. */
  @media (min-width: 720px) {
    .ends {
      flex-wrap: nowrap;
    }
  }

  nav {
    display: flex;
    gap: 1.25rem;
  }

  nav a {
    text-decoration: none;
  }

  nav a:hover {
    color: var(--ink);
  }
</style>
