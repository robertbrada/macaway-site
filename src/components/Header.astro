---
import DownloadButton from './DownloadButton.astro';
import Logo from './Logo.astro';
import { link } from '../lib/links';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={link('')}>
      <Logo />
    </a>
    <DownloadButton label="Download" small />
  </div>
</header>

<style>
  /* The settled bar is the base state, so a browser without scroll timelines still gets a
     readable header. On the home page it fades in as you leave the hero. */
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    padding-block: 14px;
    color: var(--ink);
  }

  .site-header::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: rgb(255 255 255 / 0.72);
    backdrop-filter: saturate(160%) blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }

  .bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    color: inherit;
    text-decoration: none;
  }

  .bar :global(.small) {
    padding: 0.5rem 1rem;
    font-size: 0.9375rem;
  }

  @supports (animation-timeline: scroll()) {
    .site-header:global(:has(~ main .hero))::after,
    .site-header:global(:has(~ main .hero)) :global(.download-btn) {
      animation-name: fade-in;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
      animation-range: 0 260px;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

</style>
