---
// Every Download button on the site. While there is no release, DOWNLOAD_URL is null and
// this renders a disabled button; once it is set, the same markup becomes a real link.
import Icon from './Icon.astro';
import { DOWNLOAD_URL } from '../lib/pricing';

interface Props {
  label?: string;
  small?: boolean;
  /** Which of the four buttons this is, so the click event says which one was pressed. */
  place?: 'header' | 'hero' | 'pricing' | 'thanks';
}

const { label = 'Download free trial', small = false, place } = Astro.props;
const className = small ? 'download-btn small' : 'download-btn';
const iconSize = small ? 16 : 18;
---

{
  DOWNLOAD_URL ? (
    <a class={className} href={DOWNLOAD_URL} data-track="download" data-track-place={place}>
      <Icon name="download" size={iconSize} />
      {label}
    </a>
  ) : (
    <button class={className} type="button" disabled>
      <Icon name="download" size={iconSize} />
      {label}
    </button>
  )
}
