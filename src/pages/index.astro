---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import LockPanel from '../components/LockPanel.astro';
import Shield from '../components/Shield.astro';
import DownloadButton from '../components/DownloadButton.astro';
import CopyEmail from '../components/CopyEmail.astro';
import { link } from '../lib/links';
import { BUY_PATH, CHECKOUT_OPEN, PRICE, REFUND_DAYS, TRIAL_DAYS } from '../lib/pricing';

const places = [
  { title: 'Conferences', line: 'Leave it at your seat. If someone takes it, it locks.' },
  { title: 'Cafés', line: 'Go to the counter to order. Your laptop locks at the table.' },
  { title: 'Coworking spaces', line: 'Step out to take a call. Your screen locks at your desk.' },
  { title: 'Offices', line: 'Go to a meeting. Nobody can read your email.' },
];

// What happens, in order. It answers "what happens after the trial?" before anyone asks.
const trialStops = [
  { when: 'Today', line: `Download MacAway and use it free for ${TRIAL_DAYS} days. No card needed.` },
  { when: `Day ${TRIAL_DAYS}`, line: 'MacAway stops locking and tells you.' },
  { when: 'When you are ready', line: `Buy it once for ${PRICE} and keep it.` },
];

// Only what people ask before they download or pay. `placeholder` shows a tag on an answer
// the owner still has to write.
const questions = [
  {
    question: 'Who made MacAway?',
    answer: 'One person who kept leaving their Mac open at the desk. A short line about who they are goes here.',
    placeholder: true,
  },
  {
    question: 'How do I know it never goes online?',
    answer: 'There is no networking code in the app at all. You can check it yourself: a free firewall such as LuLu shows every connection an app tries to make.',
  },
  {
    question: 'Can MacAway see my password?',
    answer: 'No. It only locks your Mac. It never sees or stores your password, and you unlock your Mac the way you always do.',
  },
  {
    question: 'Can it lock while I am still at my Mac?',
    answer: 'Sometimes, yes. If the signal from your phone drops, MacAway counts that as you leaving. If it happens too often, switch to Home, or set your own distance in Advanced.',
  },
  {
    question: `What happens after the ${TRIAL_DAYS} free days?`,
    answer: `MacAway stops locking and tells you. Buy it once for ${PRICE} to keep it.`,
  },
  {
    question: 'Is there anything to cancel?',
    answer: `No. There is no subscription and nothing renews. If MacAway is not for you, write to us within ${REFUND_DAYS} days for a full refund.`,
  },
  {
    question: 'Can I use it on more than one Mac?',
    answer: 'Yes. One purchase covers all your Macs.',
  },
  {
    question: 'Does it work with an Android phone?',
    answer: 'Not yet. Today MacAway only follows Apple devices, like an iPhone or an Apple Watch. Want it on Android? Write to',
    endsWithEmail: true,
  },
];

const facts = [
  'Pay once. No subscription',
  'For all your Macs',
  `Full refund within ${REFUND_DAYS} days`,
  'Secure checkout with Stripe and Apple\u00a0Pay',
];

const steps = [
  {
    icon: 'iphone',
    title: 'Pick what you carry',
    line: 'Any device on the same Apple ID as your Mac: a phone, a watch, even an AirTag on your keys.',
  },
  {
    icon: 'bluetooth',
    title: 'Your Mac keeps an eye on it',
    line: 'It stays connected over Bluetooth and checks how close it is, once a second.',
  },
  {
    icon: 'lock',
    title: 'Walk away and it locks',
    line: 'When the signal gets weak, your Mac locks itself. Come back in time and it stops.',
  },
] as const;

const shields = [
  { shape: 'guarding', label: "You're covered" },
  { shape: 'connecting', label: 'Still checking' },
  { shape: 'away', label: 'Locking soon' },
  { shape: 'not-protected', label: 'Not protected' },
  { shape: 'off', label: 'Off or paused' },
] as const;

const promises = [
  {
    title: 'It works without the internet',
    line: 'There is no networking code in the app at all. It has nowhere to send anything, and no account to sign up for.',
  },
  {
    title: 'It never sees your password',
    line: 'MacAway only locks your Mac. You unlock it the way you always do.',
  },
  {
    title: 'It asks for one thing: Bluetooth',
    line: 'That is the only permission macOS shows you. Not your camera, not your location, not your files.',
  },
  {
    title: "If it can't tell, it locks",
    line: 'A flat battery, or a phone left at home, counts as you walking away. It then tells you why it locked.',
  },
];
---

<Base
  title="MacAway — locks your Mac when you forget to"
  description="MacAway is a menu bar app that locks your Mac when you step away. It follows a device you already carry over Bluetooth. No account, no server, nothing to install on your phone."
>
  <Hero />

  <section class="where">
    <div class="wrap where-grid rise">
      <h2 class="eyebrow">Where it helps</h2>

      <dl class="places">
        {
          places.map((place) => (
            <div>
              <dt>{place.title}</dt>
              <dd>{place.line}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap">
      <div class="head rise">
        <h2>How it works</h2>
        <p class="lede">
          It uses your phone, your watch or an AirTag on your keys. There is nothing to
          install on them. Your Mac does all the work.
        </p>
      </div>

      <ol class="steps rise">
        {
          steps.map((step, i) => (
            <li>
              <span class="step-icon">
                <Icon name={step.icon} size={20} />
              </span>
              <h3>
                <span class="step-num">{i + 1}.</span> {step.title}
              </h3>
              <p>{step.line}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section-grey">
    <div class="wrap modes rise">
      <div class="panel-slot">
        <LockPanel />
      </div>

      <div class="modes-copy">
        <p class="eyebrow">Security mode</p>
        <h2>Choose how it locks</h2>
        <p class="lede">
          <strong>At home</strong> it waits longer, so you can walk further before it locks.{' '}
          <strong>In public</strong> it locks sooner, and from closer.
        </p>
        <p class="fine">
          Want something in between? Open <strong>Advanced</strong> and set your own distance and
          delay.
        </p>
      </div>
    </div>
  </section>

  <section class="section icons">
    <div class="wrap">
      <h2 class="eyebrow rise">Menu bar icon</h2>

      <ul class="shields rise">
        {
          shields.map((shield) => (
            <li class={`shield-${shield.shape}`}>
              <Shield shape={shield.shape} size={24} />
              <span>{shield.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap privacy-section">
      <div class="privacy-head rise">
        <h2>Nothing leaves your Mac</h2>
        <p class="lede">
          MacAway never goes online. It locks your screen, and that is the whole of it.
        </p>
      </div>

      <dl class="promises rise">
        {
          promises.map((promise) => (
            <div>
              <dt>{promise.title}</dt>
              <dd>{promise.line}</dd>
            </div>
          ))
        }
      </dl>

      <p class="more rise">
        <a class="text-link" href={link('privacy')}>What MacAway keeps, and where &rarr;</a>
      </p>
    </div>
  </section>

  <section class="section pricing" id="pricing">
    <div class="wrap pricing-grid rise">
      <div class="pricing-copy">
        <h2>Try it free. Pay once.</h2>

        <ol class="trial">
          {
            trialStops.map((stop) => (
              <li>
                <span class="when">{stop.when}</span>
                <span class="what">{stop.line}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="price-panel">
        <p class="price">
          <span class="amount">{PRICE}</span>
          <span class="per">one-time payment</span>
        </p>

        <ul class="facts">{facts.map((fact) => <li>{fact}</li>)}</ul>

        <DownloadButton />

        <p class="buy">
          Already sure?{' '}
          {
            CHECKOUT_OPEN ? (
              <a href={link(BUY_PATH)}>Buy now</a>
            ) : (
              <a class="is-off" aria-disabled="true">Buy now</a>
            )
          }
        </p>
      </div>
    </div>
  </section>

  <section class="section section-soft faq" id="faq">
    <div class="wrap faq-grid rise">
      <div class="faq-head">
        <h2>Common questions</h2>
        <p class="faq-more">
          Something else? Write to{' '}
          <CopyEmail />
        </p>
      </div>

      <div class="faq-list">
        {
          questions.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>
                {faq.placeholder && <span class="placeholder">Placeholder</span>}
                {faq.answer}
                {faq.endsWithEmail && (
                  <>
                    {' '}
                    <CopyEmail />
                  </>
                )}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    max-width: 38rem;
    margin-bottom: clamp(2.75rem, 5vw, 4rem);
  }

  /* Where it helps ---------------------------------------------------------- */

  /* A strip, not a full section: one label and four short lines, framed by a rule above
     and below so it reads as its own band between the hero and the steps. */
  .where {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.5rem);
  }

  .where-grid {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .where-grid::before,
  .where-grid::after {
    content: '';
    grid-column: 1 / -1;
    border-top: 1px solid var(--line-strong);
  }

  .where .eyebrow {
    margin: 0;
  }

  .places {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  .places dt {
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .places dd {
    margin: 0.2rem 0 0;
    text-wrap: pretty;
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  /* Four places: two by two on a tablet, one row once there is room for four. */
  @media (min-width: 720px) {
    .places {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 2.5rem);
    }
  }

  @media (min-width: 1100px) {
    .places {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* On a wide screen the label sits beside the four, which keeps the strip one row tall. */
  @media (min-width: 1000px) {
    .where-grid {
      grid-template-columns: 9.5rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  /* Steps ------------------------------------------------------------------ */

  .steps {
    display: grid;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    position: relative;
  }

  .step-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-bottom: 1.25rem;
    border-radius: 50%;
    background: var(--green-deep);
    color: #fff;
  }

  /* The count belongs in the sentence you read, not in a badge of its own. */
  .step-num {
    color: var(--green-deep);
  }

  .steps p {
    margin-top: 0.5rem;
    max-width: 32ch;
    color: var(--ink-muted);
  }

  /* Modes ------------------------------------------------------------------ */

  .modes {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .panel-slot {
    max-width: 23rem;
  }

  .modes .lede {
    max-width: 30rem;
  }

  .modes .lede strong {
    color: var(--ink);
    font-weight: 700;
  }

  /* The name of a view in the app, so it stands out from the sentence, but less than the
     two mode names above it. */
  .fine strong {
    color: var(--ink);
    font-weight: 560;
  }

  .fine {
    margin-top: 1.5rem;
    max-width: 30rem;
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  /* Menu bar icon ----------------------------------------------------------- */

  /* The five icon states are a legend, not a headline. */
  .icons {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .icons .eyebrow {
    margin-bottom: 1.5rem;
  }

  .shields {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--line);
    overflow: hidden;
  }

  .shields li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.1rem 1.35rem;
    background: var(--bg);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .shields :global(svg) {
    flex: none;
    color: var(--ink-faint);
  }

  .shield-guarding :global(svg) {
    color: var(--green-deep);
  }

  .shield-away :global(svg) {
    color: var(--amber-graphic);
  }

  /* Nothing leaves your Mac ------------------------------------------------- */

  .privacy-head {
    max-width: 30rem;
    margin-bottom: 2rem;
  }

  .more {
    margin-top: 1.75rem;
  }

  /* Ruled rows, not four boxes: the point is the reading, not the packaging. The rule
     closing the set lives on the list so it runs the full width whatever the columns do. */
  .promises {
    display: grid;
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .promises > div {
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .promises dt {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .promises dd {
    margin: 0.3rem 0 0;
    max-width: 44ch;
    color: var(--ink-muted);
  }

  /* Pricing ---------------------------------------------------------------- */

  .pricing-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .pricing h2 {
    font-size: clamp(1.875rem, 3.6vw, 2.75rem);
  }

  /* The trial as a short timeline: three stops joined by a line, the first one filled
     because it is where the reader is. */
  .trial {
    display: grid;
    gap: 1.6rem;
    margin: clamp(1.75rem, 3vw, 2.25rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .trial li {
    position: relative;
    display: grid;
    gap: 0.15rem;
    padding-left: 2rem;
  }

  .trial li::before {
    content: '';
    position: absolute;
    top: 0.4rem;
    left: 0;
    width: 11px;
    height: 11px;
    border: 1.5px solid var(--green-deep);
    border-radius: 50%;
    background: var(--bg);
    box-sizing: border-box;
  }

  .trial li:first-child::before {
    background: var(--green-deep);
  }

  /* Each stop draws the line down to the next one, so it ends at the last stop. */
  .trial li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: calc(0.4rem + 11px);
    bottom: calc(-1.6rem - 0.4rem);
    left: 5px;
    border-left: 1px solid var(--line-strong);
  }

  .when {
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .what {
    max-width: 34ch;
    color: var(--ink-muted);
  }

  /* Dark, like the app's own menu, so the price reads as the one thing to act on. */
  .price-panel {
    padding: clamp(1.75rem, 4vw, 2.5rem);
    border-radius: var(--radius-xl);
    background: var(--bg-dark);
    color: #fff;
    box-shadow: var(--shadow-lg);
  }

  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  .amount {
    font-size: clamp(2.75rem, 6vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .per {
    color: var(--ink-on-dark-muted);
  }

  .facts {
    margin: 1.5rem 0 1.75rem;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line-dark);
  }

  .facts li {
    padding-block: 0.7rem;
    border-top: 1px solid var(--line-dark);
    color: var(--ink-on-dark-muted);
  }

  .price-panel :global(.download-btn) {
    width: 100%;
    justify-content: center;
  }

  .buy {
    margin-top: 1rem;
    font-size: 0.9375rem;
    text-align: center;
    color: var(--ink-on-dark-muted);
  }

  .buy a {
    color: #fff;
    font-weight: 600;
    text-underline-offset: 4px;
  }

  /* No checkout yet: it reads as a link, but it goes nowhere. */
  .buy .is-off {
    text-decoration: none;
    cursor: not-allowed;
  }

  @media (min-width: 900px) {
    .pricing-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      column-gap: clamp(3rem, 7vw, 6rem);
    }
  }

  /* Questions --------------------------------------------------------------- */

  .faq-grid {
    display: grid;
    gap: 2rem;
  }

  .faq-more {
    margin-top: 1rem;
    color: var(--ink-muted);
  }

  .faq :global(.contact) {
    color: var(--ink);
    font-weight: 600;
  }

  /* Ruled rows like the promises, closed by default, so the questions read as one short
     list you can scan before opening any of them. */
  .faq-list {
    border-bottom: 1px solid var(--line-strong);
  }

  .faq-list details {
    border-top: 1px solid var(--line-strong);
  }

  .faq-list summary {
    position: relative;
    padding: 1.1rem 2.5rem 1.1rem 0;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    list-style: none;
    cursor: pointer;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  /* A plus that turns into a minus: two bars, the upright one folds away when open. */
  .faq-list summary::before,
  .faq-list summary::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 0.25rem;
    width: 14px;
    height: 1.5px;
    border-radius: 1px;
    background: var(--ink-muted);
  }

  .faq-list summary::after {
    transform: rotate(90deg);
  }

  .faq-list details[open] summary::after {
    transform: rotate(0deg);
  }

  .faq-list summary:hover::before,
  .faq-list summary:hover::after {
    background: var(--ink);
  }

  .faq-list summary:focus-visible {
    outline: 2px solid var(--green-deep);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .faq-list details p {
    max-width: 60ch;
    padding-bottom: 1.25rem;
    color: var(--ink-muted);
  }

  .placeholder {
    display: inline-block;
    margin-right: 0.5rem;
    padding: 0.1rem 0.55rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-pill);
    background: var(--bg);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: 0.1em;
    color: var(--ink-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq-list summary::after {
      transition: transform 200ms ease;
    }
  }

  @media (min-width: 900px) {
    .faq-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      column-gap: clamp(3rem, 7vw, 6rem);
      align-items: start;
    }

    /* Lines the heading's capitals up with the first question's, as in the section above. */
    .faq-head h2 {
      margin-top: calc(1.5625rem - 0.13em);
    }
  }

  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    /* A rule between the numbers reads as one sequence, not three tiles. */
    .steps li:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 21px;
      left: 54px;
      right: -2rem;
      height: 1px;
      background: var(--line);
    }

    .shields {
      grid-template-columns: repeat(5, 1fr);
    }

    .shields li {
      flex-direction: column;
      gap: 0.75rem;
      padding: 1.6rem 1rem;
      text-align: center;
    }
  }

  @media (min-width: 900px) {
    .modes {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    /* Heading and words on the left, the four promises down the right. */
    .privacy-section {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      grid-template-areas:
        'head list'
        'more list';
      grid-template-rows: auto 1fr;
      column-gap: clamp(3rem, 7vw, 6rem);
      align-items: start;
    }

    .privacy-head {
      grid-area: head;
      margin-bottom: 0;
    }

    /* Line the heading's capitals up with the first promise's: the list starts with a rule
       and 1.5rem of padding, so the heading drops by that, less the small gap above its own
       capitals, which grows with its size. */
    .privacy-head h2 {
      margin-top: calc(2rem - 0.13em);
    }

    .promises {
      grid-area: list;
    }

    .more {
      grid-area: more;
    }
  }

  /* Below the fold on a phone the picture is the caption, so the words come first. */
  @media (max-width: 899px) {
    .panel-slot {
      order: 2;
      max-width: none;
    }
  }
</style>
