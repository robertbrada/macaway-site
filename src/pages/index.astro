---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import LockPanel from '../components/LockPanel.astro';
import GearMenu from '../components/GearMenu.astro';
import Shield from '../components/Shield.astro';
import DownloadButton from '../components/DownloadButton.astro';
import CopyEmail from '../components/CopyEmail.astro';
import portrait from '../assets/author.webp';
import { link, MAKER_LINKEDIN, MAKER_PORTFOLIO } from '../lib/links';
import {
  APP_VERSION,
  BUY_PATH,
  CHECKOUT_OPEN,
  PRICE,
  PRICE_USD,
  REFUND_DAYS,
  TRIAL_DAYS,
} from '../lib/pricing';

const places = [
  { icon: 'screen', title: 'Conferences', line: 'Leave it at your seat. If someone takes it, it locks.' },
  { icon: 'cup', title: 'Cafés', line: 'Go to the counter to order. Your laptop locks at the table.' },
  { icon: 'people', title: 'Coworking spaces', line: 'Step out to take a call. Your screen locks at your desk.' },
  { icon: 'building', title: 'Offices', line: 'Go to a meeting. Nobody can read your email.' },
] as const;

// What happens, in order. It answers "what happens after the trial?" before anyone asks.
const trialStops = [
  { when: 'Today', line: `Download MacAway and use it free for ${TRIAL_DAYS} days. No card needed.` },
  { when: `Day ${TRIAL_DAYS}`, line: 'MacAway stops locking and tells you.' },
  { when: 'When you are ready', line: `Buy it once for ${PRICE} and keep it forever.` },
];

// What people ask before they buy, and what they asked on Reddit about how it behaves. The
// numbers are the app's defaults; check them in the app repo when they change.
const questions = [
  {
    question: 'Is MacAway on the App Store?',
    answer:
      'No. You download it straight from this page, or install it with Homebrew. It is signed and checked by Apple, so macOS opens it like any other app.',
  },
  {
    question: 'Is MacAway safe?',
    answer:
      'To lock your Mac, it needs only Bluetooth. Unlocking is off until you turn it on, and then your password stays in your Mac’s keychain. The only thing MacAway contacts is its own update feed, and nothing about you or your devices is sent. You can check that yourself with a free firewall such as LuLu.',
  },
  {
    question: 'Do I need to install anything on my phone?',
    answer:
      'No. There is nothing to install and nothing to set up. Your Mac does all the work. You only pick which device it should follow.',
  },
  {
    question: 'How does it know I walked away?',
    answer:
      'Never from one reading. It averages the last 8 readings, about 8 seconds. When that average gets weaker than your limit, a countdown starts. Your Mac locks at the end, unless your device comes back 10 dB stronger first. Normal mode uses −80 dBm and 15 seconds, and you can change both. A device next to you reads −40 to −60 dBm, so its usual ups and downs don’t come close.',
  },
  {
    question: 'What if my phone’s battery dies?',
    answer:
      'After 30 seconds with no signal, it counts as gone, and your Mac locks after the wait you set. If your Mac’s own Bluetooth is off, MacAway can’t see anything, so it doesn’t lock. The menu then says Not protected.',
  },
  {
    question: 'Can a phone left on my desk unlock my Mac?',
    answer:
      'No. Unlocking is off until you turn it on. Even then, MacAway types your password only when one of your devices left while your Mac was locked and came back, none is still away, the last 5 readings average −60 dBm or stronger, and your own account is on the screen. A phone on your desk never left. It tries once per lock, and if the password doesn’t work, it stops and tells you. The one thing it can’t know is who is carrying your phone.',
  },
  {
    question: 'Does unlocking work if my Mac goes to sleep?',
    answer:
      'Not while it sleeps, because a sleeping Mac can’t hear your phone. Locking doesn’t put your Mac to sleep, but macOS may later. Caffeine mode keeps it awake while it is locked, and can keep the screen on so you see it unlock.',
  },
  {
    question: 'Does it work with the lid closed on an external display?',
    answer: 'Yes, the same as with the lid open.',
  },
  {
    question: 'Does it work with an Android phone?',
    answer:
      'Not yet. Today MacAway only follows Apple devices, like an iPhone or an Apple Watch. Want it on Android? Write to',
    endsWithEmail: true,
  },
  {
    question: `What happens after the ${TRIAL_DAYS} free days?`,
    answer: `MacAway stops locking and tells you. Buy it once for ${PRICE} to keep it. Nothing renews, so there is nothing to cancel.`,
  },
  {
    question: 'Can I use it on more than one Mac?',
    answer: 'Yes. One purchase covers all your Macs.',
  },
];

// Two places to look me up. Both leave the site, so both open in a new tab.
const profiles = [
  { href: MAKER_LINKEDIN, label: 'LinkedIn' },
  { href: MAKER_PORTFOLIO, label: 'My other work' },
];

const facts = [
  `${TRIAL_DAYS} days free. No card needed`,
  'Pay once. No subscription',
  'For all your Macs',
  `Full refund within ${REFUND_DAYS} days`,
  'Secure checkout with Stripe and Apple\u00a0Pay',
];

const steps = [
  {
    icon: 'iphone',
    title: 'Pick what you carry',
    line: 'Any device on the same Apple ID as your Mac: a phone, a watch, AirPods, even an AirTag on your keys.',
  },
  {
    icon: 'bluetooth',
    title: 'Your Mac keeps an eye on it',
    line: 'It stays connected over Bluetooth and checks how close it is, once a second.',
  },
  {
    icon: 'lock',
    title: 'Walk away and it locks',
    line: 'When the signal gets weak, your Mac locks itself. Come back in time and it stops.',
  },
] as const;

// None of these promises that you are close to your Mac: with two devices, the close one can
// be a phone left on the desk.
const unlockFacts = [
  'It is off until you turn it on in the gear menu.',
  'It unlocks only after your phone or watch has been away.',
  'Your password stays in your Mac’s keychain.',
];

const shields = [
  { shape: 'guarding', label: "You're covered" },
  {
    shape: 'guarding-awake',
    label: 'Caffeine mode on',
    tip: 'Your Mac stays awake. It still locks when you walk away.',
  },
  { shape: 'connecting', label: 'Still checking' },
  { shape: 'away', label: 'Locking soon' },
  { shape: 'not-protected', label: 'Not protected' },
  { shape: 'off', label: 'Off or paused' },
] as const;

const promises = [
  {
    title: 'It works without the internet',
    line: 'Locking needs no connection, and there is no account to sign up for. The only thing MacAway contacts is its own update feed, to ask whether a newer version exists.',
  },
  {
    title: 'Your password stays on your Mac',
    line: 'MacAway needs no password to lock. If you turn on unlocking, it keeps your password in your Mac’s keychain. Turn unlocking off and it is deleted.',
  },
  {
    title: 'Locking needs only Bluetooth',
    line: 'Not your camera, not your location, not your files. If you turn on unlocking, it also needs Accessibility, so it can type your password.',
  },
  {
    title: "If it can't tell, it locks",
    line: 'A flat battery, or a phone left at home, counts as you walking away. It then tells you why it locked.',
  },
];

// Lets a search engine read the price and the platform as values rather than out of the prose.
// Built from pricing.ts for the same reason llms.txt is: one price, one place.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'MacAway',
  applicationCategory: 'SecurityApplication',
  operatingSystem: 'macOS 13 or later',
  ...(APP_VERSION && { softwareVersion: APP_VERSION }),
  url: 'https://macaway.app/',
  offers: {
    '@type': 'Offer',
    price: PRICE_USD,
    priceCurrency: 'USD',
  },
};
---

<Base
  title="MacAway: your Mac locks when you walk away"
  description="MacAway is a menu bar app that locks your Mac when you step away, and can unlock it when you come back. It follows a device you already carry over Bluetooth. No account, no server, nothing to install on your phone."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <Hero />

  <section class="where">
    <div class="wrap where-grid rise">
      <h2 class="eyebrow">Where it helps</h2>

      <dl class="places">
        {
          places.map((place) => (
            <div>
              <dt>
                <Icon name={place.icon} />
                {place.title}
              </dt>
              <dd>{place.line}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap">
      <div class="head rise">
        <h2>How it works</h2>
        <p class="lede">
          There is nothing to install on your phone. Your Mac does all the work.
        </p>
      </div>

      <ol class="steps rise">
        {
          steps.map((step, i) => (
            <li>
              <span class="step-icon">
                <Icon name={step.icon} size={20} />
              </span>
              <h3>
                <span class="step-num">{i + 1}.</span> {step.title}
              </h3>
              <p>{step.line}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section icons">
    <div class="wrap">
      <h2 class="eyebrow rise">Menu bar icon</h2>

      <ul class="shields rise">
        {
          shields.map((shield) => (
            <li
              class={`shield-${shield.shape}`}
              tabindex={'tip' in shield ? 0 : undefined}
              aria-describedby={'tip' in shield ? `tip-${shield.shape}` : undefined}
            >
              <Shield shape={shield.shape} size={24} />
              <span class={'tip' in shield ? 'has-tip' : undefined}>{shield.label}</span>
              {'tip' in shield && (
                <span class="tip" role="tooltip" id={`tip-${shield.shape}`}>
                  {shield.tip}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-grey">
    <div class="wrap modes rise">
      <div class="panel-slot">
        <LockPanel />
      </div>

      <div class="modes-copy">
        <p class="eyebrow">Modes</p>
        <h2>Choose how it locks</h2>
        <p class="lede">
          <strong>Normal</strong> waits longer, so you can walk further before it locks.{' '}
          <strong>Strict</strong> locks sooner, and from closer.
        </p>
        <p class="fine">
          Want your own? Open <strong>Advanced</strong> to change the distance and the wait, or
          choose <strong>Add mode</strong> to make a new one.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="unlock">
    <div class="wrap unlock rise">
      <div class="unlock-copy">
        <h2>Unlock when you come back</h2>
        <p class="lede">
          Walk back to your Mac and MacAway unlocks it. You do not have to type your password.
        </p>

        <ul class="unlock-facts">{unlockFacts.map((fact) => <li>{fact}</li>)}</ul>
      </div>

      <GearMenu />
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap privacy-section">
      <div class="privacy-head rise">
        <h2>Nothing leaves your Mac</h2>
        <p class="lede">
          There is no account and nothing to sign in to. What MacAway knows about you stays on
          your Mac.
        </p>
      </div>

      <dl class="promises rise">
        {
          promises.map((promise) => (
            <div>
              <dt>{promise.title}</dt>
              <dd>{promise.line}</dd>
            </div>
          ))
        }
      </dl>

      <p class="more rise">
        <a class="text-link" href={link('privacy')}>What MacAway keeps, and where &rarr;</a>
      </p>
    </div>
  </section>

  <section class="section pricing" id="pricing">
    <div class="wrap pricing-grid rise">
      <div class="pricing-copy">
        <h2>Try it free. Pay once.</h2>

        <ol class="trial">
          {
            trialStops.map((stop) => (
              <li>
                <span class="when">{stop.when}</span>
                <span class="what">{stop.line}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="price-panel">
        <p class="price">
          <span class="amount">{PRICE}</span>
          <span class="per">one-time payment</span>
        </p>

        <ul class="facts">{facts.map((fact) => <li>{fact}</li>)}</ul>

        <DownloadButton place="pricing" />

        <p class="buy">
          Already sure?{' '}
          {
            CHECKOUT_OPEN ? (
              <a href={link(BUY_PATH)} data-track="buy" data-track-place="pricing">Buy now</a>
            ) : (
              <a class="is-off" aria-disabled="true">Buy now</a>
            )
          }
        </p>
      </div>
    </div>
  </section>

  <section class="section section-soft faq" id="faq">
    <div class="wrap faq-grid rise">
      <div class="faq-head">
        <h2>Common questions</h2>
        <p class="faq-more">
          Something else? Write to{' '}
          <CopyEmail />
        </p>
      </div>

      <div class="faq-list">
        {
          questions.map((faq) => (
            <details>
              <summary data-track="faq">{faq.question}</summary>
              <p>
                {faq.answer}
                {faq.endsWithEmail && (
                  <>
                    {' '}
                    <CopyEmail />
                  </>
                )}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="maker" id="maker">
    <div class="wrap maker-row rise">
      <div class="portrait">
        <Image
          src={portrait}
          alt="Robert Brada, who makes MacAway."
          widths={[128, 256, 384]}
          sizes="128px"
          loading="lazy"
        />
      </div>

      <div class="maker-copy">
        <h2>Author</h2>
        <p>
          Hi, I'm Robert 👋 I kept seeing my colleagues walk away from their laptops with
          everything still open. So I made a small app that locks the Mac for them when they
          leave.
        </p>
        <p>Questions or ideas? Write to me. I read and answer every email myself.</p>

        <p class="profiles">
          {
            profiles.map((profile) => (
              <a class="text-link" href={profile.href} target="_blank" rel="noopener">
                {profile.label}
                <span aria-hidden="true"> &#8599;</span>
              </a>
            ))
          }
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    max-width: 38rem;
    margin-bottom: clamp(2.75rem, 5vw, 4rem);
  }

  /* Where it helps ---------------------------------------------------------- */

  /* A strip, not a full section: one label and four short lines, framed by a rule above
     and below so it reads as its own band between the hero and the steps. */
  .where {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.5rem);
  }

  .where-grid {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .where-grid::before,
  .where-grid::after {
    content: '';
    grid-column: 1 / -1;
    border-top: 1px solid var(--line-strong);
  }

  .where .eyebrow {
    margin: 0;
  }

  .places {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  .places dt {
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* A light line drawing of the place, in the green the "Works with" icons use, to catch the
     eye on the way down. Sized in em and centred on the cap height, as every icon by text is.
     A heavier line than the icon's own, to sit with a bold heading rather than look faint. */
  .places dt :global(.icon) {
    width: 1.25em;
    height: 1.25em;
    margin-right: 0.45em;
    vertical-align: -0.27em;
    stroke-width: 1.8;
    color: var(--green-deep);
  }

  .places dd {
    margin: 0.2rem 0 0;
    text-wrap: pretty;
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  /* Four places: two by two on a tablet, one row once there is room for four. */
  @media (min-width: 720px) {
    .places {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 2.5rem);
    }
  }

  @media (min-width: 1100px) {
    .places {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* On a wide screen the label sits beside the four, which keeps the strip one row tall. */
  @media (min-width: 1000px) {
    .where-grid {
      grid-template-columns: 9.5rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  /* Steps ------------------------------------------------------------------ */

  .steps {
    display: grid;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    position: relative;
  }

  .step-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-bottom: 1.25rem;
    border-radius: 50%;
    background: var(--green-deep);
    color: #fff;
  }

  /* The count belongs in the sentence you read, not in a badge of its own. */
  .step-num {
    color: var(--green-deep);
  }

  .steps p {
    margin-top: 0.5rem;
    max-width: 32ch;
    color: var(--ink-muted);
  }

  /* Unlock when you come back ------------------------------------------------ */

  /* Less padding on top: it shares the white band with the steps above. */
  /* The same grid as the modes section above, mirrored, so the two line up. */
  .unlock {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .unlock .lede {
    max-width: 30rem;
  }

  .unlock-facts {
    max-width: 30rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  .unlock-facts li {
    padding-block: 0.8rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .unlock {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  /* Modes ------------------------------------------------------------------ */

  .modes {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .panel-slot {
    max-width: 25rem;
  }

  .modes .lede {
    max-width: 30rem;
  }

  .modes .lede strong {
    color: var(--ink);
    font-weight: 700;
  }

  /* The name of a view in the app, so it stands out from the sentence, but less than the
     two mode names above it. */
  .fine strong {
    color: var(--ink);
    font-weight: 560;
  }

  .fine {
    margin-top: 1.5rem;
    max-width: 30rem;
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  /* Menu bar icon ----------------------------------------------------------- */

  /* The six icon states are a legend, not a headline. It comes straight after the steps, as
     what you see in the menu bar while they happen, so it shares their white band: less
     padding on top. */
  .icons {
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(3.5rem, 7vw, 5.5rem);
  }

  .icons .eyebrow {
    margin-bottom: 1.5rem;
  }

  /* Rules between the cells, not a clipped grid, so a tooltip can rise above the list. */
  .shields {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }

  .shields li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.1rem 1.35rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .shields li + li {
    border-top: 1px solid var(--line);
  }

  /* A dotted line under the words, as the usual sign that there is more on hover. */
  .has-tip {
    text-decoration: underline dotted var(--ink-faint);
    text-underline-offset: 0.25em;
  }

  .shields li[tabindex] {
    cursor: help;
  }

  .shields li[tabindex]:focus-visible {
    outline: 2px solid var(--green-deep);
    outline-offset: -2px;
    border-radius: var(--radius);
  }

  .tip {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 2.8rem;
    z-index: 2;
    width: max-content;
    max-width: 15rem;
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius);
    background: var(--bg-dark);
    color: #fff;
    box-shadow: var(--shadow-lg);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.4;
    text-align: left;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .tip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 1.6rem;
    border: 6px solid transparent;
    border-top-color: var(--bg-dark);
  }

  .shields li:hover .tip,
  .shields li:focus .tip {
    opacity: 1;
    visibility: visible;
  }

  .shields :global(svg) {
    flex: none;
    color: var(--ink-faint);
  }

  .shield-guarding :global(svg),
  .shield-guarding-awake :global(svg) {
    color: var(--green-deep);
  }

  .shield-away :global(svg) {
    color: var(--amber-graphic);
  }

  /* Nothing leaves your Mac ------------------------------------------------- */

  .privacy-head {
    max-width: 30rem;
    margin-bottom: 2rem;
  }

  .more {
    margin-top: 1.75rem;
  }

  /* Ruled rows, not four boxes: the point is the reading, not the packaging. The rule
     closing the set lives on the list so it runs the full width whatever the columns do. */
  .promises {
    display: grid;
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .promises > div {
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .promises dt {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .promises dd {
    margin: 0.3rem 0 0;
    max-width: 44ch;
    color: var(--ink-muted);
  }

  /* Pricing ---------------------------------------------------------------- */

  .pricing-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .pricing h2 {
    font-size: clamp(1.875rem, 3.6vw, 2.75rem);
  }

  /* The trial as a short timeline: three stops joined by a line, the first one filled
     because it is where the reader is. */
  .trial {
    display: grid;
    gap: 1.6rem;
    margin: clamp(1.75rem, 3vw, 2.25rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .trial li {
    position: relative;
    display: grid;
    gap: 0.15rem;
    padding-left: 2rem;
  }

  .trial li::before {
    content: '';
    position: absolute;
    top: 0.4rem;
    left: 0;
    width: 11px;
    height: 11px;
    border: 1.5px solid var(--green-deep);
    border-radius: 50%;
    background: var(--bg);
    box-sizing: border-box;
  }

  .trial li:first-child::before {
    background: var(--green-deep);
  }

  /* Each stop draws the line down to the next one, so it ends at the last stop. */
  .trial li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: calc(0.4rem + 11px);
    bottom: calc(-1.6rem - 0.4rem);
    left: 5px;
    border-left: 1px solid var(--line-strong);
  }

  .when {
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .what {
    max-width: 34ch;
    color: var(--ink-muted);
  }

  /* Dark, like the app's own menu, so the price reads as the one thing to act on. */
  .price-panel {
