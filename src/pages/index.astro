---
import Base from '../layouts/Base.astro';
import Shield from '../components/Shield.astro';
import Shot from '../components/Shot.astro';
import WalkAway from '../components/WalkAway.astro';
import { link } from '../lib/links';

const shields = [
  { shape: 'guarding', name: 'Padlock', text: 'A followed device is measured near right now.' },
  { shape: 'connecting', name: 'Outline', text: 'Starting, or still working out where the devices are.' },
  { shape: 'away', name: 'Exclamation', text: 'A device has left, and the Mac is about to lock.' },
  {
    shape: 'not-protected',
    name: 'Cross',
    text: 'Not protected: nothing followed, this Mac’s Bluetooth off or not allowed, or a lock that did not work.',
  },
  { shape: 'off', name: 'Slash', text: 'Off, paused, or every device on hold.' },
] as const;

const points = [
  {
    title: 'It measures, it does not guess',
    body: 'Your Mac holds a Bluetooth link to each device and reads the signal once a second, averaged over the last five to eight readings. An advertisement only proves a device is in range, so MacAway never reads one as a distance.',
  },
  {
    title: 'Follow more than one thing',
    body: 'Any device measured leaving means you left. The phone you left on the desk never masks the watch that walked out of the room with you.',
  },
  {
    title: 'A phone is not the only answer',
    body: 'The picker offers every device macOS already names, so an AirTag on your keyring or a pair of AirPods answers just as well. What matters is that it is on you, and not on the desk.',
  },
  {
    title: 'Cheap enough to leave on',
    body: 'Measured while following two devices at once: 1.4% of one core. There is no telemetry to send and no server to talk to, so that is the whole cost.',
  },
];
---

<Base
  title="MacAway — your Mac locks when you walk away"
  description="MacAway locks your Mac within seconds of you walking away, following the iPhone or Apple Watch already on you over Bluetooth. No account, no server, no app on your phone."
>
  <section class="hero">
    <div class="wrap">
      <p class="status-pill">Not released yet</p>
      <h1>MacAway locks your Mac within seconds of you walking away.</h1>
      <p class="lede">
        It follows the iPhone or Apple Watch already on you, over Bluetooth. There is nothing
        to install on them, as long as they are signed in to the same Apple&nbsp;ID as your
        Mac. No account, no server, and nothing is sent anywhere.
      </p>
      <p class="requirements">
        Built for macOS&nbsp;13 and later, universal for Apple silicon and Intel &middot; it
        has only ever been run on Apple silicon, on macOS&nbsp;26
      </p>
    </div>

    <div class="wrap hero-shot rise">
      <Shot
        caption="The menu, open on a protected Mac: the status line, the followed devices with what each one reads, and the on/off switch."
        ratio="16 / 10"
      />
    </div>
  </section>

  <WalkAway />

  <section class="section">
    <div class="wrap">
      <p class="eyebrow rise">What it does</p>
      <h2 class="rise">The threat is the thirty seconds after you stand up</h2>
      <p class="lede rise">
        Find&nbsp;My and Activation Lock own what happens after a laptop is gone. MacAway is
        for the moment it is still happening: a conference, a coworking desk, a café, a
        shared office &mdash; anywhere the Mac is somewhere you do not control.
      </p>

      <ul class="points rise">
        {
          points.map((point) => (
            <li>
              <h3>{point.title}</h3>
              <p>{point.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-sunken">
    <div class="wrap">
      <p class="eyebrow rise">When it cannot tell</p>
      <h2 class="rise">Not knowing where you are is not the same as you being there</h2>

      <div class="rules rise">
        <div class="rule">
          <h3>Thirty seconds without a reading counts as away</h3>
          <p>
            A flat battery, a device switched off, a walk out of range. Which one it was does
            not matter, because none of them is evidence that you are still at the Mac.
          </p>
        </div>
        <div class="rule">
          <h3>Twelve seconds of hearing nothing at all is gone</h3>
          <p>
            The link to an iPhone drops for a few seconds every minute or two while it is
            being handled. That reads as unknown, never as gone.
          </p>
        </div>
        <div class="rule rule-wide">
          <h3>A fault at this end is not a departure</h3>
          <p>
            If this Mac&rsquo;s own Bluetooth is off, not allowed or resetting, no countdown
            starts and nothing locks &mdash; nobody can turn Bluetooth off on a Mac that is
            already locked, so treating it as a departure would only lock the Mac on its
            owner. The clock restarts when the radio comes back.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow rise">Every lock explains itself</p>
        <h2 class="rise">MacAway errs towards locking</h2>
        <p class="lede rise">
          A lock you did not need is the accepted price. The work goes into making each one
          cost almost nothing.
        </p>
        <div class="prose rise">
          <p>
            Unlock while a device still reads away and that device goes on hold, so the same
            reading cannot lock the Mac twice. A window tells you which device it was, what it
            read, and which numbers were in force at the time.
          </p>
          <p>
            It offers the one correction for whatever caused this lock &mdash; a less
            sensitive threshold after a weak reading, a longer wait after hearing nothing
            &mdash; and closes itself when the device comes back. Every lock, and every
            answer, goes into a journal that keeps a week.
          </p>
        </div>
      </div>
      <div class="rise">
        <Shot
          caption="The window after a lock: the device, its reading, the numbers in force, and the one correction offered."
          ratio="4 / 3"
        />
      </div>
    </div>
  </section>

  <section class="section section-sunken">
    <div class="wrap">
      <p class="eyebrow rise">The menu bar</p>
      <h2 class="rise">Five shapes, and only one of them claims cover</h2>
      <p class="lede rise">
        The shield in the menu bar and the status line inside the menu are drawn by the same
        code, so the two cannot disagree with each other.
      </p>

      <ul class="shields rise">
        {
          shields.map((s) => (
            <li>
              <span class={`glyph glyph-${s.shape}`}>
                <Shield shape={s.shape} size={30} />
              </span>
              <div>
                <h3>{s.name}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow rise">Two settings</p>
      <h2 class="rise">One for a room you control, one for a room you do not</h2>

      <div class="settings rise">
        <div class="setting">
          <h3>Home</h3>
          <p class="numbers">Far at &minus;75 dBm &middot; locks 15 s later</p>
          <p>
            The looser of the two, and what a new Mac starts on. The stricter one produced
            five wrong locks out of six on the day that was measured, which is no way to meet
            a piece of software.
          </p>
        </div>
        <div class="setting">
          <h3>In public</h3>
          <p class="numbers">Far at &minus;65 dBm &middot; locks 5 s later</p>
          <p>
            For a desk you are sharing with strangers. It reads you as gone sooner and waits
            less, and it wears a yellow badge on the menu bar shield so you can see at a
            glance which one is running.
          </p>
        </div>
      </div>

      <p class="footnote rise">
        Either one&rsquo;s numbers can be changed under Advanced and put back. The lock delay
        takes any value from 3 to 90 seconds, and the sliders reach settings stricter than
        either choice &mdash; MacAway says so in amber when you go there. One switch pauses
        everything, and any single device can be paused on its own.
      </p>
    </div>
  </section>

  <section class="section section-sunken">
    <div class="wrap never">
      <p class="eyebrow rise">What it never does</p>
      <h2 class="rise">It locks. That is all it does.</h2>
      <ul class="rise">
        <li>
          <strong>It never unlocks your Mac</strong>, and it never stores or types your
          password. You type it yourself, as usual.
        </li>
        <li>
          <strong>It has no account and no server.</strong> Today&rsquo;s app contains no
          networking code at all &mdash; the measuring happens on your Mac and stays there.
        </li>
        <li>
          <strong>It sends no telemetry</strong>, and it asks for one permission: Bluetooth.
        </li>
      </ul>
      <p class="rise">
        <a class="text-link" href={link('privacy')}>Read the privacy notice &rarr;</a>
      </p>
    </div>
  </section>

  <section class="section closing">
    <div class="wrap wrap-narrow">
      <h2 class="rise">Not released yet</h2>
      <p class="lede rise">
        MacAway is not finished and there is nothing to download. Nobody but its author has
        run it, so there is no version here, no sign-up, and nothing to try.
      </p>
      <p class="rise closing-note">
        When it is ready it will be a direct download, signed and notarised. It cannot go on
        the Mac App Store: locking a screen instantly needs a private macOS interface that has
        no public alternative.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(3rem, 7vw, 5.5rem);
  }

  .hero h1 {
    margin-top: 1.5rem;
    max-width: 17ch;
  }

  .requirements {
    margin-top: 1.75rem;
    font-size: 0.9375rem;
    color: var(--ink-faint);
    max-width: 46ch;
  }

  .hero-shot {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .points {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 2rem 2.5rem;
  }

  .points h3,
  .rule h3 {
    margin-bottom: 0.5rem;
  }

  .points p,
  .rule p {
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .rules {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    gap: 1.25rem;
  }

  .rule {
    padding: 1.6rem 1.75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .two-col {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .prose {
    margin-top: 1.5rem;
    display: grid;
    gap: 1rem;
    color: var(--ink-soft);
    max-width: var(--measure);
  }

  .shields {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem 2.5rem;
  }

  .shields li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .shields h3 {
    font-size: 1.0625rem;
    margin-bottom: 0.2rem;
  }

  .shields p {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .glyph {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .glyph-guarding {
    color: var(--accent);
    background: var(--accent-wash);
    border-color: var(--accent-line);
  }

  .glyph-away {
    color: var(--warn-graphic);
    background: var(--warn-wash);
    border-color: var(--warn-line);
  }

  .settings {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    gap: 1.25rem;
  }

  .setting {
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .setting h3 {
    font-size: 1.375rem;
  }

  .numbers {
    margin: 0.4rem 0 0.9rem;
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }

  .setting p:last-child {
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .footnote {
    margin-top: 1.75rem;
    max-width: var(--measure);
    font-size: 0.9375rem;
    color: var(--ink-faint);
  }

  .never h2,
  .never ul,
  .never p {
    max-width: 44rem;
  }

  .never ul {
    list-style: none;
    margin: 2rem 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
    color: var(--ink-soft);
  }

  .never li {
    padding-left: 1.6rem;
    position: relative;
  }

  .never li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .never strong {
    color: var(--ink);
    font-weight: 620;
  }

  .text-link {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  .text-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .closing {
    text-align: center;
  }

  .closing .lede {
    margin-inline: auto;
  }

  .closing-note {
    margin: 1.75rem auto 0;
    max-width: 44ch;
    font-size: 0.9375rem;
    color: var(--ink-faint);
  }

  @media (min-width: 720px) {
    .points {
      grid-template-columns: 1fr 1fr;
    }

    .rules {
      grid-template-columns: 1fr 1fr;
    }

    .rule-wide {
      grid-column: 1 / -1;
    }

    .shields {
      grid-template-columns: 1fr 1fr;
    }

    .settings {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 960px) {
    .two-col {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    }
  }
</style>
