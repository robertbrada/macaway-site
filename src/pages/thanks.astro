---
import CopyEmail from '../components/CopyEmail.astro';
import DownloadButton from '../components/DownloadButton.astro';
import Base from '../layouts/Base.astro';
import { link } from '../lib/links';
---

<Base
  title="Thank you — MacAway"
  description="Your MacAway licence key, and how to add it to the app."
  noindex
>
  <article class="doc">
    <div class="wrap">
      <header class="doc-head">
        <h1>Thank you</h1>
        <p class="lede">MacAway is yours. Here is the key that unlocks it.</p>
      </header>

      <section>
        <p id="loading">Fetching your key…</p>

        <div id="key-ready" hidden>
          <p class="key" id="licence-key"></p>
          <p class="actions">
            <a class="download-btn" id="activate" href="#" data-track="activate">Activate MacAway</a>
            <button class="copy" id="copy" type="button" data-track="copy_key">Copy key</button>
          </p>
          <p>
            Keep this key somewhere safe. We have emailed it to you as well, and this page
            shows the same key whenever you come back to it, so it is worth a bookmark.
          </p>
        </div>

        <div id="key-missing" hidden>
          <p>
            We could not find that purchase. Write to <CopyEmail /> from the address you paid
            with and we will send your key.
          </p>
        </div>
      </section>

      <section>
        <h2>Adding the key by hand</h2>
        <p>
          Open MacAway, click the gear at the bottom of the panel,
          choose <strong>Enter licence key…</strong> and paste it in.
        </p>
      </section>

      <section>
        <h2>If MacAway is not on this Mac yet</h2>
        <p>Download it first, then come back to this page for the key.</p>
        <DownloadButton label="Download MacAway" place="thanks" />
      </section>

      <p class="back"><a href={link('')}>Back to the home page</a></p>
    </div>
  </article>
</Base>

<script define:vars={{ licenceEndpoint: link('api/licence') }}>
  const sessionId = new URLSearchParams(location.search).get('session_id');
  const loading = document.getElementById('loading');
  const ready = document.getElementById('key-ready');
  const missing = document.getElementById('key-missing');

  const show = (element) => {
    loading.hidden = true;
    element.hidden = false;
  };

  const showKey = (licenceKey) => {
    document.getElementById('licence-key').textContent = licenceKey;
    document.getElementById('activate').href =
      `macaway://activate?key=${encodeURIComponent(licenceKey)}`;
    show(ready);
  };

  const copy = document.getElementById('copy');
  copy.addEventListener('click', async () => {
    await navigator.clipboard.writeText(document.getElementById('licence-key').textContent);
    copy.textContent = 'Copied';
  });

  if (!sessionId) {
    show(missing);
  } else {
    fetch(`${licenceEndpoint}?session_id=${encodeURIComponent(sessionId)}`)
      .then((response) => (response.ok ? response.json() : null))
      .then((body) => (body ? showKey(body.licenceKey) : show(missing)))
      .catch(() => show(missing));
  }
</script>

<style>
  .doc {
    padding-block: clamp(6rem, 10vw, 8rem) clamp(4rem, 8vw, 6rem);
  }

  .doc :global(.wrap) > * {
    max-width: 44rem;
  }

  .doc-head {
    padding-bottom: 2.5rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .doc-head h1 {
    font-size: clamp(2.5rem, 7vw, 3.75rem);
  }

  .doc section {
    margin-top: 3rem;
  }

  .doc h2 {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    margin-bottom: 1rem;
  }

  .doc p {
    color: var(--ink-muted);
    margin-bottom: 1rem;
  }

  .doc strong {
    color: var(--ink);
    font-weight: 620;
  }

  /* The Activate button is a link too, and would take the link colour over its own. */
  .doc a:not(.download-btn) {
    color: var(--green-deep);
    text-underline-offset: 3px;
  }

  .key {
    padding: 1rem 1.15rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-soft);
    color: var(--ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9375rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
    /* One click takes the whole key. */
    user-select: all;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .copy {
    padding: 0.9rem 1.4rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .back {
    margin-top: 3.5rem;
  }
</style>
