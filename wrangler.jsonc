{
  "name": "macaway-site",
  "compatibility_date": "2026-09-30",
  "main": "./worker/index.ts",
  // The pages are files Cloudflare serves from what `npm run build` puts in dist. The worker
  // only runs for paths with no file behind them: /buy and /api/*.
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "vars": {
    // Sandbox. Swap for the live price, together with the live secret key.
    "CHECKOUT_PRICE_ID": "price_1UM1BjKB1uND0xu7BB4Nhg2W",
    "LICENCE_EMAIL_FROM": "MacAway <keys@macaway.app>",
    "SUPPORT_EMAIL": "support@macaway.app"
  }
}
