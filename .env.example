# Copy to .env.local for a local run, and set both in Cloudflare's build settings for the
# live site. Without the key nothing is loaded and no events are sent.

# "Project API Key" from PostHog, Settings -> Project. Not a secret: it ends up in the page.
PUBLIC_POSTHOG_KEY=

# Must match the region the project lives in, or every event is dropped.
# US cloud: https://us.i.posthog.com   EU cloud: https://eu.i.posthog.com
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
